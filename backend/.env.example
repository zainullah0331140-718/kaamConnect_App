# Copy to .env and adjust for your environment.

APP_NAME=KaamConnect API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# SQLite by default. For Postgres, e.g.:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/kaamconnect
DATABASE_URL=sqlite:///./kaamconnect.db

# IMPORTANT: set a long random value in production.
JWT_SECRET=dev-only-change-me-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_EXPIRE_MINUTES=30

# Comma-separated list. Use * for development only.
CORS_ORIGINS=*

# Seed the demo accounts used by the app's quick-fill login buttons.
SEED_DEMO_DATA=true

# No email service is configured; the reset token is returned in the
# password-reset response so the in-app reset flow works. Disable in production.
EXPOSE_RESET_TOKEN=true

# Bootstrap admin account.
ADMIN_EMAIL=zainullah0331140@gmail.com
ADMIN_PASSWORD=AdminPass123!
ADMIN_FULL_NAME=Zain Ullah
